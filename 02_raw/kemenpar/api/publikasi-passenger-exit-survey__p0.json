nfaat bagi pengguna untuk berbagai keperluan. Untuk mempermudah akses terhadap publikasi maka publikasi ini dapat diunduh melalui laman resmi Kementerian Pariwisata (www.kemenpar.go.id) tanpa berbayar. Jika ada saran yang konstruktif dari para pengguna publikasi ini untuk penyempurnaan pada edisi yang akan datang.  Saran dan masukan dapat dilayangkan melalui email [datin.tik@kemenpar.go.id](mailto:datin.tik@kemenpar.go.id?subject=PES%202016) dan\/atau [pusdatinkemenpar@gmail.com](mailto:pusdatinkemenpar@gmail.com?subject=PES%202016).&#160;<a href=\"https:\/\/api.kemenpar.go.id\/storage\/app\/resources\/media_1565674428_PES_2016_-_Revisi_Tabel_22.pdf\" target=\"_blank\">Download Passenger Exit Survey 2016.pdf<\/a>","is_active":1,"is_draft":0,"created_at":"2020-12-02T17:15:43.000000Z","updated_at":"2025-05-05T06:14:23.000000Z","deleted_at":null,"create_by_id":19,"update_by_id":127,"delete_by_id":null,"category_id":30,"posted_by":"Kemenparekraf\/ Baparekraf RI","published_at":"2020-12-03 00:00:00","is_pinned":0,"is_preview_excel":0,"files":[],"featured_image":{"id":14031,"disk_name":"6818573fbcac3516978616.jpg","file_name":"49.jpg","file_size":126084,"content_type":"image\/jpeg","title":null,"description":null,"field":"featured_image","sort_order":14031,"created_at":"2025-05-05T06:14:23.000000Z","updated_at":"2025-05-05T06:14:23.000000Z","path":"https:\/\/api.kemenpar.go.id\/storage\/app\/uploads\/public\/681\/857\/3fb\/6818573fbcac3516978616.jpg","extension":"jpg"},"category":{"id":30,"name":"Publikasi Passenger Exit Survey","slug":"publikasi-passenger-exit-survey","is_active":1,"created_at":"2020-12-09T06:19:44.000000Z","updated_at":"2020-12-09T06:19:44.000000Z"},"create_by":null}],"first_page_url":"https:\/\/api.kemenpar.go.id\/api\/v1\/statistics\/posts?page=1","from":1,"last_page":1,"last_page_url":"https:\/\/api.kemenpar.go.id\/api\/v1\/statistics\/posts?page=1","links":[{"url":null,"label":"pagination.previous","active":false},{"url":"https:\/\/api.kemenpar.go.i