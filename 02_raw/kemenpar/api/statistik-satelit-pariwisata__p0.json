_at":"2026-03-25T04:20:15.000000Z","deleted_at":null,"create_by_id":37,"update_by_id":37,"delete_by_id":null,"category_id":26,"posted_by":"Biro Data dan Sistem Informasi","published_at":"2026-03-25 00:00:00","is_pinned":0,"is_preview_excel":0,"files":[{"id":15786,"disk_name":"69c35e801b717223105738.pdf","file_name":"24. Perkembangan TSA.pdf","file_size":122424,"content_type":"application\/pdf","title":null,"description":null,"field":"files","sort_order":15786,"created_at":"2026-03-25T04:03:12.000000Z","updated_at":"2026-03-25T04:03:12.000000Z","path":"https:\/\/api.kemenpar.go.id\/storage\/app\/uploads\/public\/69c\/35e\/801\/69c35e801b717223105738.pdf","extension":"pdf"}],"featured_image":{"id":15787,"disk_name":"69c35e801f64d773205495.png","file_name":"24. Perkembangan TSA.png","file_size":313317,"content_type":"image\/png","title":null,"description":null,"field":"featured_image","sort_order":15787,"created_at":"2026-03-25T04:03:12.000000Z","updated_at":"2026-03-25T04:03:12.000000Z","path":"https:\/\/api.kemenpar.go.id\/storage\/app\/uploads\/public\/69c\/35e\/801\/69c35e801f64d773205495.png","extension":"png"},"category":{"id":26,"name":"Statistik Satelit Pariwisata","slug":"statistik-satelit-pariwisata","is_active":1,"created_at":"2020-12-09T05:50:08.000000Z","updated_at":"2020-12-09T05:50:08.000000Z"},"create_by":{"id":37,"name":"richard","email":"richard.alanamory@kemenpar.go.id","permissions":null,"is_activated":true,"activated_at":null,"last_login":null,"created_at":"2020-12-22T04:45:21.000000Z","updated_at":"2025-01-24T06:33:29.000000Z","username":"richard","surname":"","deleted_at":null,"last_seen":"2026-09-01T07:58:01.000000Z","is_guest":0,"is_superuser":0,"created_ip_address":null,"last_ip_address":null,"user_type":1,"category":null,"campus_id":null,"department":null,"year_of_study":null,"gender":null,"date_of_birth":null,"phone":null,"is_profile_completed":0,"bio":null,"department_id":null,"is_sso":0,"is_mail_blocked":0,"first_name":"richard","last_name":"","notes":null,"primary_group_id":null,"remember_token":null,"banned_reason":null,"banned_at":null,"two_factor_secret":null,"two_factor_recovery_codes":null,"two_factor_confirmed_at":null,"avatar":null}},{"id":10032,"name":"Perkembangan PDB Sektor Pariwisata Tahun 2023","slug":"perkembangan-tourism-satellite-account-indonesia-tahun-2023","description":"<p style=\"text-align: justify;\"><span style=\"background-color: transparent; font-size: 0.875rem;\">Tren kontribusi industri pariwisata Indonesia terhadap produk domestik bruto (PDB) nasional sejak tahun 2020 hingga 2023 menunjukkan dinamika yang erat kaitannya dengan dampak pandemi COVID-19. Pada tahun 2020, kontribusi pariwisata mengalami penurunan tajam menjadi 2,23 persen dari sebelumnya 4,97 persen pada tahun 2019. Penurunan ini disebabkan oleh pembatasan perjalanan, penurunan jumlah wisatawan, dan perlambatan aktivitas ekonomi global. Kondisi serupa masih berlanjut pada tahun 2021, di mana kontribusi pariwisata hanya sedikit meningkat menjadi 2,30 persen. Namun, sejak tahun 2022, sektor pariwisata mulai menunjukkan tanda-tanda pemulihan seiring dengan pelonggaran pembatasan perjalanan dan meningkatnya mobilitas masyarakat. Pemulihan ini semakin menguat pada tahun 2023, dengan kontribusi pariwisata terhadap PDB meningkat signifikan menjadi 4,67 persen, mendekati tingkat pra-pandemi. Capaian ini menunjukkan bahwa sektor pariwisata mulai kembali menjadi salah satu penggerak utama pertumbuhan ekonomi nasional.<\/span><\/p>","is_active":1,"is_draft":0,"created_at":"2025-07-09T06:36:12.000000Z","updated_at":"2025-07-09T06:36:55.000000Z","deleted_at":null,"create_by_id":37,"update_by_id":37,"delete_by_id":null,"category_id":26,"posted_by":"Biro Data dan Sistem Informasi","published_at":"2025-07-09 00:00:00","is_pinned":0,"is_preview_excel":0,"files":[{"id":14364,"disk_name":"686e0ddc24868107039673.pdf","file_name":"23. Perkembangan TSA.pdf","file_size":134693,"content_type":"application\/pdf","title":null,"descrip